{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPull",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:ap-south-1:801949252238:repository/tickerapp-backend",
        "arn:aws:ecr:ap-south-1:801949252238:repository/tickerapp-frontend",
        "arn:aws:ecr:ap-south-1:801949252238:repository/tickerapp-postgres"
      ]
    }
  ]
}
